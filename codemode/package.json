{
  "name": "figma-design-validator-codemode",
  "version": "0.1.0",
  "description": "Code mode for MCP servers: the model writes code that calls tools inside a Deno sandbox. Defaults to figma-design-validator.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-mode",
    "sandbox",
    "deno",
    "figma-design-validator"
  ],
  "author": "Vinodh M",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VinodhDeva/figma-design-validator.git",
    "directory": "codemode"
  },
  "type": "module",
  "bin": {
    "figma-design-validator-codemode": "dist/index.js"
  },
  "files": [
    "dist",
    "servers",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "generate": "node dist/index.js generate --out servers -- node ../dist/index.js",
    "check:wrappers": "node dist/index.js generate --check --out servers -- node ../dist/index.js",
    "test": "node --test \"test/*.test.ts\"",
    "bench": "node bench/bench.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "deno": "^2.9.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
