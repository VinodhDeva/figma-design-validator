{
  "name": "figma-design-validator",
  "version": "0.5.0",
  "description": "Deterministic UI-vs-Figma validation MCP server (layout, screenshots, accessibility) over STDIO",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "figma",
    "playwright",
    "ui-testing",
    "visual-regression",
    "accessibility",
    "claude-code",
    "kiro",
    "code-mode",
    "sandbox"
  ],
  "author": "Vinodh M",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VinodhDeva/figma-design-validator.git"
  },
  "homepage": "https://github.com/VinodhDeva/figma-design-validator#readme",
  "bugs": {
    "url": "https://github.com/VinodhDeva/figma-design-validator/issues"
  },
  "type": "module",
  "bin": {
    "figma-design-validator": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/unit/*.test.ts\"",
    "test:integration": "npm run build && node --test \"test/integration/*.test.ts\"",
    "test:all": "npm run build && node --test \"test/**/*.test.ts\"",
    "prepare": "npm run build",
    "codemode:generate": "npm run build && node dist/index.js --codemode generate --out servers",
    "codemode:check": "npm run build && node dist/index.js --codemode generate --check --out servers",
    "bench:codemode": "npm run build && node bench/codemode.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "axe-core": "^4.14.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "typescript": "^7.0.2"
  }
}
