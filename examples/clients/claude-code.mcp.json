{
  "mcpServers": {
    "ui-validation": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "figma-design-validator"
      ],
      "env": {
        "UI_VALIDATION_CONFIG": "./ui-validation.config.json",
        "FIGMA_TOKEN": "${FIGMA_TOKEN}"
      }
    }
  }
}
