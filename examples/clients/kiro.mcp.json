{
  "mcpServers": {
    "ui-validation": {
      "command": "npx",
      "args": [
        "-y",
        "figma-design-validator"
      ],
      "env": {
        "UI_VALIDATION_CONFIG": "./ui-validation.config.json"
      },
      "disabled": false,
      "autoApprove": [
        "inspect_design",
        "inspect_ui",
        "validate_layout",
        "compare_screenshots"
      ]
    }
  }
}
